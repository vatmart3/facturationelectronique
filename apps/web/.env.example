# Copier en .env.local et renseigner depuis Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optionnel : URL publique utilisée dans les liens envoyés par email (sinon déduite de la requête).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Facultatif : envoi des emails (factures, relances) via Resend. Sans clé, les envois sont simulés. ---
RESEND_API_KEY=
# Adresse d'expédition vérifiée chez Resend, ex. « Pastille <factures@votre-domaine.fr> ».
EMAIL_EXPEDITEUR=

# --- Facultatif : tâche quotidienne (relances et factures récurrentes, vercel.json). ---
# Clé secrète Supabase (Project Settings > API > service_role / secret). Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Secret partagé avec Vercel Cron (Vercel l'envoie automatiquement si la variable existe).
CRON_SECRET=

# --- Facultatif : plateforme agréée (API normalisée AFNOR XP Z12-013). Sans ces variables, la plateforme simulée est utilisée. ---
PA_API_URL=
PA_API_TOKEN=
# Secret de signature des notifications envoyées par la plateforme vers /api/plateforme.
PA_WEBHOOK_SECRET=

# --- Facultatif : abonnements Stripe (Billing). Sans ces variables, le choix d'offre affiche « paiement bientôt disponible ». ---
STRIPE_SECRET_KEY=
# Secret du point de terminaison webhook <site>/api/stripe (événements customer.subscription.* et checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix mensuels (price_…) créés dans Stripe pour chaque offre.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# --- Identité de l'éditeur, reprise dans les mentions légales, CGU, CGV, confidentialité et DPA. À renseigner avant la mise en vente. ---
EDITEUR_RAISON_SOCIALE=
EDITEUR_FORME=
EDITEUR_SIREN=
EDITEUR_RCS=
EDITEUR_TVA=
EDITEUR_ADRESSE=
EDITEUR_DIRECTEUR_PUBLICATION=
EDITEUR_EMAIL=
EDITEUR_EMAIL_DONNEES=
EDITEUR_MEDIATEUR=
